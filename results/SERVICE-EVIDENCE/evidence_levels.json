 "level_policy": {
  "published": "a frase citada (doc_source da página fixada, ou nó do schema do binário assinado do pin em web_citation) diz o valor; o resolver confere na fonte fixada",
  "derived": "regra declarada em value.rule sobre fatos publicados do mesmo arquivo (derived_from)",
  "interpreted": "leitura do modelo claude-opus-5-5 sobre a frase citada; value.basis diz o que foi inferido além do texto",
  "unknown": "status unknown com unknown_reason; a citação é a publicação consultada (título da página, ou as chaves do bloco do tipo no schema quando não há página), para refazer a busca"
 },
 "rules": {
  "R-BRIDGE-GCP-APIDOC": "linha '* [API documentation](https://cloud.google.com/...)' da página do tipo: serviço = 1º segmento do caminho; versão = segmento v<n>[alpha|beta<n>] depois de reference/[rest/]; recurso = o resto do caminho (sem âncora). Serviço e recurso aparecem literalmente na frase.",
  "R-BRIDGE-OCI-APIDOC": "linha 'Api doc link for the resource: https://docs.oracle.com/iaas/api/#/en/<svc>/<ver>/<Res>': serviço, versão do link e recurso literais na frase.",
  "R-BRIDGE-AZ-ARMID": "ID de importação ARM da página (C03 import_id): serviço = namespace depois de /providers/; recurso = os segmentos de TIPO do caminho (posições pares depois do namespace) unidos por '/'.",
  "R-BRIDGE-AWS-SUBCAT": "AWS: a página do tipo não nomeia o recurso de API; serviço = subcategoria literal do front matter; recurso = UNKNOWN.",
  "R-APIREF-AWS": "links docs.aws.amazon.com/.../APIReference/API_<Nome>.html na página: nome literal (operação ou tipo de dado; o link não diz qual).",
  "R-IMPORT-DOC": "seção Import da página (formatos, atributos, métodos), como gravada pelo DOCS-* ou relida da página fixada (google).",
  "R-ID-SCHEMA": "resource_identity_schemas do schema fixado: atributos required_for_import e optional_for_import.",
  "R-ID-AZ-TEMPLATE": "ID de importação ARM -> modelo: cada segmento de NOME vira {nome do tipo que o precede}; a importação usa o 'resource id' ou 'resource manager id' (frase da chave), então a identidade é esse ID.",
  "R-ID-GCP-LONGEST": "formato de importação mais longo (mais placeholders) da seção Import.",
  "R-ID-OCI-PLAIN": "importação pelo 'id' simples -> identidade = atributo id do tipo.",
  "R-ID-OCI-FORMAT": "importação por formato composto -> identidade = o formato literal.",
  "R-ID-AWS-ATTRS": "importação AWS por atributos -> identidade = atributos na ordem da frase, com os separadores da frase.",
  "R-OWN-AZ-PARENT": "modelo ARM com mais de um par tipo/nome depois do namespace -> pai = o prefixo sem o último par; com um par -> contêiner = resourceGroups (ou subscriptions, se não há resourceGroups).",
  "R-OWN-GCP-PARENT": "modelo de importação google: coleção = segmento antes de cada {{placeholder}}, ignorando locations, regions, zones e global; pai = a penúltima coleção; projects/organizations/folders/billingAccounts = contêiner.",
  "R-OWN-AWS-IDENTITY": "identidade do schema com account_id e/ou region -> alcance conta e/ou região.",
  "R-OWN-DOC-PARENT": "descrição literal de atributo de referência que diz 'belongs to', 'in which', 'that contains' ou 'compartment' -> atributo dono citado.",
  "R-SCOPE-DOC": "frase literal com '<account|organization|project|folder|subscription|tenancy|management group|enterprise|bucket|container|network|vpc>-level', 'at the <X> level' ou 'all <coisas> in the <X>' -> alcance efetivo = X.",
  "R-LIFE-DOC": "frase literal que diz que destruir/remover o recurso só o tira do state, não apaga, ou suspende (efeito de destruição diferente de apagar o objeto).",
  "R-LIFE-DELETION-POLICY": "atributo deletion_policy documentado com valores ABANDON/DELETE (quem decide o fim do objeto de API ao destruir).",
  "R-CONN-DOC": "atributo stateless/stateful/connection tracking, ou descrição que diz stateful/stateless: frase literal e default datado do DOCS-*.",
  "R-EFFECT-DOC": "atributo de efeito (access, action, effect, rule_action) com valores permitidos literais que incluem allow/deny/accept/drop/reject, ou bloco allow/deny descrito como 'ALLOW/DENY rules'.",
  "R-PREC-DOC": "atributo de ordem (priority, precedence, rule_number, sequence, order) com frase literal; ordem = lower_value_first quando a frase diz que valor menor tem precedência ou que se processa em ordem crescente; higher_value_first no inverso; senão UNKNOWN.",
  "R-TAG-ATTR": "atributo de tag do provedor no nível de cima do tipo (aws/azurerm: tags; google: labels; oci: freeform_tags e defined_tags) presente no schema fixado; frase do doc quando há.",
  "R-TAG-ABSENT": "nenhum atributo de tag do provedor entre as chaves de atributo do nível de cima do schema fixado -> o recurso Terraform não aceita tag (outro recurso de tag pode existir).",
  "R-TTL-ATTR": "atributo (qualquer profundidade) cujo nome casa o léxico de expiração; alvo pela frase: self (o próprio recurso é apagado/terminado), contained (objetos, mensagens, itens, eventos, versões), cache (cache/DNS), senão UNKNOWN.",
  "R-ABSENT-PAGE": "a página fixada do tipo (citada pelo título) foi lida inteira e nenhuma regra acima casou: UNKNOWN/not_documented (ausência de frase não é ausência do recurso).",
  "R-ABSENT-NOPAGE": "o tipo está no schema fixado mas não tem página na tag fixada: UNKNOWN/not_documented, citando as chaves do bloco do tipo no schema.",
  "R-BLOCK-SCHEMA": "forma do bloco aninhado no schema fixado (nesting_mode, min/max_items, atributos com flags r/o/c, sub-blocos), citada pelo ponteiro com op=shape.",
  "R-BLOCK-ID": "schema_identity = present se o bloco tem atributo computed id/arn/self_link/ocid, senão absent (só o schema; nada sobre a API); element_name_candidates = atributos obrigatórios name/key do bloco; max_per_parent = 1 se nesting single ou max_items 1.",
  "R-BLOCK-OWNER": "o bloco só existe dentro da configuração do pai no schema fixado: a configuração é gravada pelo recurso Terraform do pai (kind parent, via = pai estrutural, camada terraform).",
  "R-BLOCK-LIFE": "o bloco não tem recurso Terraform próprio: nasce e some com o pai (kind parent, camada terraform); o ciclo do objeto na API não é dito.",
  "R-ID-SHARED": "tipos cujo resource_identity_schema tem o mesmo conjunto de campos obrigatórios, fora os genéricos (id, name, arn, region, account_id, project, location, zone, subscription_id, resource_group_name, compartment_id), são endereçados pela mesma chave de identidade.",
  "C-PILOT-LITERAL": "fato escolhido à mão numa frase da página fixada; o valor repete o que a frase diz.",
  "C-PILOT-GAP": "tipo das fatias dos pilotos sem frase para este tipo de fato na página fixada: UNKNOWN explícito (a lacuna é resultado; não se preenche com conhecimento de fora do pin).",
  "I-PILOT-READING": "leitura do modelo sobre a frase citada (granularidade, interação entre níveis, regra implícita); value.basis diz o que foi inferido além do texto."
 },
