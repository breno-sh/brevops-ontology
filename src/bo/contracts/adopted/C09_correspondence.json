   "properties": {
    "byte_convention": {
     "enum": [
      "SI",
      "IEC",
      null
     ]
    },
    "components": {
     "type": "array"
    },
    "datatype": {
     "enum": [
      "integer",
      "decimal",
      "boolean",
      "string",
      "enum",
      "duration",
      "tuple"
     ]
    },
    "enum": {
     "type": "array"
    },
    "quantity_kind": {
     "description": "IRI QUDT (quantitykind:...) | NOT_APPLICABLE | UNKNOWN",
     "type": "string"
    },
    "range": {
     "type": "object"
    },
    "rate_window": {
     "description": "xsd:duration fixa (parte do tipo, N4)",
     "type": [
      "string",
      "null"
     ]
    },
    "required": {
     "type": "boolean"
    },
    "sentinels": {
     "type": "object"
    },
    "step": {
     "type": [
      "string",
      "integer"
     ]
    },
    "unit": {
     "description": "IRI QUDT (unit:...) | NOT_APPLICABLE | UNKNOWN",
     "type": "string"
    }
   },
