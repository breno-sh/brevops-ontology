    },
    "required": {
     "type": "boolean"
    },
    "sentinels": {
     "type": "object"
    },
    "step": {
     "type": [
      "string",
      "integer"
     ]
    },
    "unit": {
     "description": "IRI QUDT (unit:...) | NOT_APPLICABLE | UNKNOWN",
     "type": "string"
    }
   },
   "required": [
    "datatype"
   ],
   "type": "object"
  },
  "predicate_id": {
   "enum": [
    "skos:exactMatch",
    "skos:closeMatch",
    "skos:broadMatch",
    "skos:narrowMatch",
    "skos:relatedMatch"
   ]
  },
  "preserved_observations": {
   "items": {
    "type": "string"
   },
   "type": "array"
  },
  "projection": {
   "type": "array"
  },
  "proof": {
   "properties": {
    "evidence": {
     "type": "array"
    },
    "tests": {
     "type": "array"
    },
    "type": {
     "type": "string"
    }
   },
   "required": [
    "type"
   ],
   "type": "object"
  },
  "semantic_relation": {
   "enum": [
    "exact",
    "close",
    "broad",
    "narrow",
    "related"
