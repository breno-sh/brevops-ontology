      "name": {
       "enum": [
        "duration_to_number",
        "enum_map",
        "identity",
        "join_alarm_query",
        "join_cidr",
        "join_port_range",
        "json_get",
        "map_get",
        "number_to_duration",
        "rate_window_convert",
        "scale",
        "split_alarm_query",
        "split_cidr",
        "split_port_range",
        "unit_convert"
