   "type": "string"
  },
  "claim_version_id": {
   "type": "string"
  },
  "event_id": {
   "type": "string"
  },
  "evidence_state": {
   "enum": [
    "UNRESOLVED",
    "STRUCTURALLY_VALID",
    "DOC_SUPPORTED",
    "PERSISTENCE_VERIFIED",
    "OBSERVATION_TESTED"
   ]
  },
  "fixed_default": {
   "properties": {
    "evidence": {
     "required": [
      "date",
      "source"
     ],
     "type": "object"
    },
    "kind": {
     "enum": [
      "fixed",
      "default"
     ]
    }
   },
   "required": [
    "kind",
    "value",
    "context",
    "evidence"
   ],
   "type": "object"
  },
  "group": {
   "type": "object"
  },
  "guard": {
   "$ref": "#/$defs/guard"
  },
  "loss_contract": {
   "items": {
    "properties": {
     "kind": {
      "enum": [
       "rounding",
       "saturation",
       "absence",
       "sentinel",
       "context_dependence",
       "not_expressible",
       "semantic"
      ]
     }
    },
    "required": [
     "kind"
    ],
    "type": "object"
   },
   "type": "array"
  },
  "mapping_justification": {
   "pattern": "^semapv:",
   "type": "string"
  },
  "membership_predicate": {
   "properties": {
    "expr": {
     "properties": {
      "op": {
       "enum": [
        "in",
        "eq",
        "range",
        "and",
        "or",
        "not",
        "field"
       ]
      }
     },
     "type": "object"
    },
    "subset": {
     "enum": [
      "subject",
      "object"
     ]
    },
    "tests": {
     "required": [
      "members",
      "non_members"
     ],
     "type": "object"
    }
   },
   "required": [
    "subset",
    "expr",
    "tests"
   ],
   "type": "object"
  },
  "object_concept": {
   "type": "string"
  },
  "object_id": {
   "type": "string"
  },
