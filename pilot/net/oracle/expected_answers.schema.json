{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/brevops/pilot/net/expected_answers.schema.json",
  "title": "Gabarito da fatia NET do piloto (PILOT-NET-ORACLE), C24 1.1.0",
  "description": "Adotado pelo C24 1.1.0 (emenda 5 do CONTRACTS, tipo pilot_expected_answers); o gate do módulo confere este e o validador único.",
  "type": "object",
  "required": ["schema", "contract", "contract_version", "module", "slice", "oracle", "inputs_sha256", "mandatory_cases",
               "fixtures", "translations", "directions", "counts", "retained_index"],
  "properties": {
    "schema": {"const": "bo.pilot_net.expected_answers/1"},
    "contract": {"const": "C24"},
    "contract_version": {"enum": ["1.0.0", "1.1.0"]},
    "module": {"const": "PILOT-NET-ORACLE"},
    "slice": {"const": "net"},
    "oracle": {"type": "object", "required": ["path", "version", "reading", "api"]},
    "inputs_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "minProperties": 3},
    "mandatory_cases": {
      "type": "object", "minProperties": 10,
      "propertyNames": {"pattern": "^NET-C\\d{2}$"},
      "additionalProperties": {
        "type": "object", "required": ["name", "commitments", "requirements", "calib", "retained"],
        "properties": {
          "commitments": {"type": "array", "minItems": 1, "items": {"pattern": "^CMT-[A-Z]{2,8}-[PNU]\\d{2}$"}},
          "calib": {"type": "object", "required": ["positive", "negative", "unknown"],
                    "additionalProperties": {"type": "array", "minItems": 1}},
          "retained": {"type": "object", "required": ["positive", "negative", "unknown"],
                       "additionalProperties": {"type": "integer", "minimum": 1}}
        }
      }
    },
    "fixtures": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "required": ["provider", "case", "polarity", "commitment_ids", "check", "decisions", "validity", "decomposition"],
        "properties": {
          "provider": {"enum": ["aws", "google", "azurerm", "oci"]},
          "polarity": {"enum": ["positive", "negative", "unknown"]},
          "check": {"type": "object", "required": ["kind", "assertion"],
                    "properties": {"kind": {"enum": ["count", "entails", "invariant", "not_entails", "rejects", "unknown"]}}},
          "decisions": {"type": "object", "minProperties": 1, "additionalProperties": {
            "type": "object", "required": ["value", "why"],
            "properties": {"value": {"enum": ["ALLOW", "DENY", "UNKNOWN"]},
                           "code": {"enum": ["MISSING_EVIDENCE", "INCOMPLETE_READ", "UNKNOWN_SYMBOLIC_INPUT"]}},
            "if": {"properties": {"value": {"const": "UNKNOWN"}}}, "then": {"required": ["code"]}}},
          "validity": {"type": "object", "required": ["value"], "properties": {"value": {"enum": ["VALID", "INVALID", "UNKNOWN"]}}},
          "decomposition": {"type": "array", "items": {
            "type": "object", "required": ["domain_unit", "kind", "parent", "occurrence", "tf", "evidence"],
            "properties": {"kind": {"enum": ["ENTITY", "COMPONENT", "FACET", "BINDING", "UNKNOWN"]},
                           "evidence": {"type": "array", "minItems": 1}}}}
        }
      }
    },
    "translations": {
      "type": "object", "minProperties": 12,
      "additionalProperties": {
        "type": "object", "required": ["direction", "polarity", "source_fixture", "declared_losses", "expected", "per_flow", "c11_case_seed"],
        "properties": {
          "direction": {"pattern": "^(aws|google|azurerm|oci)->(aws|google|azurerm|oci)$"},
          "expected": {"type": "object", "required": ["verdict", "why"],
                       "properties": {"verdict": {"enum": ["ACCEPT", "ACCEPT_WITH_DECLARED_LOSS", "UNDETERMINED", "REJECT"]}}},
          "c11_case_seed": {"type": "object", "required": ["case_id", "group_id", "stratum_partial", "side", "comparator", "cost_class", "pending"],
                            "properties": {"case_id": {"pattern": "^CASE-[A-Za-z0-9_\\-]+$"}, "group_id": {"pattern": "^(GRP|G)-[A-Za-z0-9_\\-]+$"}}}
        }
      }
    },
    "directions": {"type": "object", "minProperties": 12, "maxProperties": 12},
    "counts": {"type": "object", "required": ["calib", "retained"]},
    "retained_index": {"type": "string"}
  }
}
