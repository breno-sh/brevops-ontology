  "terraform": {
   "resource": {
    "oci_objectstorage_bucket": {
     "src": {
      "access_type": "NoPublicAccess",
      "compartment_id": "${var.compartment_id}",
      "name": "fx-src",
      "namespace": "${var.namespace}"
     }
    },
    "oci_objectstorage_object_lifecycle_policy": {
     "src": {
      "bucket": "${oci_objectstorage_bucket.src.name}",
      "namespace": "${var.namespace}",
      "rules": [
       {
        "action": "DELETE",
        "is_enabled": true,
        "name": "expire",
        "target": "objects",
        "time_amount": 30,
        "time_unit": "DAYS"
       }
      ]
     }
    }
   },
   "variable": {
    "compartment_id": {
     "type": "string"
    },
    "namespace": {
     "type": "string"
    }
   }
  },
  "timeline": {
   "container": "oci_objectstorage_bucket.src",
   "eval_day": 40,
   "events": [
    {
     "day": 0,
     "key": "old.bin",
     "op": "put"
    },
    {
     "day": 10,
     "key": "edge.bin",
     "op": "put"
    },
    {
     "day": 11,
     "key": "young.bin",
     "op": "put"
