{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://w3id.org/brevops/contracts/C15/results.schema.json",
 "title": "C15 results 3.1.0: resultados e especificação de métricas",
 "description": "operational_coverage{lower, upper, est, n} por leitura (field | decision | graph | complete_unit) e por eixo (representability | transportability | operational | persistence | behavior); quantifier (existential | universal | observed_fraction); frame, inclusion, weights; incerteza conjunta; ausências como auditoria separada; o campo da v2 com o termo antigo saiu (nenhuma chave com ele).",
 "x-bo-contract": {
  "id": "C15",
  "name": "results",
  "version": "3.1.0",
  "status": "amended",
  "owner": "CONTRACTS",
  "files": [
   {
    "kind": "metrics_spec",
    "file": "metrics_spec.yaml",
    "format": "yaml",
    "record": "metrics_spec",
    "unit": "document"
   },
   {
    "kind": "summary_results",
    "file": "summary.json",
    "format": "json",
    "record": "summary_results",
    "unit": "document",
    "note": "summary.json catalogado como C15: C17 + bloco results"
   },
   {
    "kind": "result",
    "file": "*.json",
    "format": "json",
    "record": "result",
    "unit": "document"
   }
  ],
  "semantic_rules": [
   "C15-BOUNDS: lower <= est <= upper; est nulo se e só se n = 0 ou n_known = 0; n_known <= n",
   "C15-OLDTERM: nenhuma chave com o termo antigo da v2",
   "C15-CORR: correlated_with só cita metric_id do mesmo documento",
   "C15-UNIQ: metric_id único"
  ],
  "producers": [
   "(quase todos: results/<ID>/*.json)"
  ],
  "consumers": [
   "MATRIX",
   "METRICSLIB",
   "STATS"
  ],
  "adopted_from": []
 },
 "$defs": {
  "metric": {
   "type": "object",
   "properties": {
    "metric_id": {
     "type": "string",
     "minLength": 1,
     "pattern": "^M-[A-Za-z0-9_\\-]+$"
    },
    "name": {
     "type": "string",
     "minLength": 3
    },
    "reading": {
     "enum": [
      "field",
      "decision",
      "graph",
      "complete_unit"
     ]
    },
    "axis": {
     "enum": [
      "representability",
      "transportability",
      "operational",
      "persistence",
      "behavior"
     ]
    },
    "quantifier": {
     "enum": [
      "existential",
      "universal",
      "observed_fraction"
     ]
    },
    "operational_coverage": {
     "type": "object",
     "properties": {
      "lower": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "upper": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "est": {
       "anyOf": [
        {
         "type": "null"
        },
        {
         "type": "number",
         "minimum": 0,
         "maximum": 1
        }
       ]
      },
      "n": {
       "type": "integer",
       "minimum": 0
      },
      "n_known": {
       "type": "integer",
       "minimum": 0,
       "description": "unidades com desfecho conhecido; est = sucessos/n_known, nulo se n_known = 0 (emenda 3.1.0)"
      }
     },
     "required": [
      "lower",
      "upper",
      "est",
      "n"
     ],
     "additionalProperties": false
    },
    "frame": {
     "type": "object",
     "properties": {
      "ref": {
       "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/file_ref"
      },
      "description": {
       "type": "string",
       "minLength": 5
      }
     },
     "required": [
      "description"
     ],
     "additionalProperties": false
    },
    "inclusion": {
     "type": "object",
     "properties": {
      "rule_id": {
       "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/rule_id"
      },
      "text": {
       "type": "string",
       "minLength": 5
      }
     },
     "required": [
      "rule_id",
      "text"
     ],
     "additionalProperties": false
    },
    "weights": {
     "type": "object",
     "properties": {
      "scheme": {
       "enum": [
        "uniform",
        "frame",
        "inverse_probability",
        "custom"
       ]
      },
      "ref": {
       "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/file_ref"
      }
     },
     "required": [
      "scheme"
     ],
     "additionalProperties": false,
     "allOf": [
      {
       "if": {
        "properties": {
         "scheme": {
          "const": "custom"
         }
        }
       },
       "then": {
        "required": [
         "ref"
        ]
       }
      }
     ]
    },
    "joint_uncertainty": {
     "type": "object",
     "properties": {
      "method": {
       "enum": [
        "bootstrap",
        "delta",
        "bayesian",
        "exact",
        "wilson",
        "none"
       ]
      },
      "level": {
       "type": "number",
       "exclusiveMinimum": 0,
       "exclusiveMaximum": 1
      },
      "correlated_with": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^M-[A-Za-z0-9_\\-]+$"
       },
       "uniqueItems": true
      }
     },
     "required": [
      "method"
     ],
     "additionalProperties": false
    }
   },
   "required": [
    "metric_id",
    "name",
    "reading",
    "axis",
    "quantifier",
    "operational_coverage",
    "frame",
    "inclusion",
    "weights",
    "joint_uncertainty"
   ],
   "additionalProperties": false,
   "propertyNames": {
    "not": {
     "pattern": "(?i)(ceiling|teto)"
    }
   }
  },
  "result": {
   "type": "object",
   "properties": {
    "schema": {
     "const": "bo.result/1"
    },
    "contract": {
     "const": "C15"
    },
    "contract_version": {
     "enum": [
      "3.0.0",
      "3.1.0"
     ]
    },
    "module": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/stable_id"
    },
    "generated_at": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/datetime"
    },
    "metrics": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/metric"
     },
     "minItems": 1
    },
    "absence_audit": {
     "type": "object",
     "properties": {
      "n_absences": {
       "type": "integer",
       "minimum": 0
      },
      "n_audited": {
       "type": "integer",
       "minimum": 0
      },
      "method": {
       "type": "string",
       "minLength": 5
      },
      "ref": {
       "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/file_ref"
      }
     },
     "required": [
      "n_absences",
      "n_audited",
      "method"
     ],
     "additionalProperties": false,
     "description": "ausências como auditoria separada (não entram no numerador nem no denominador)"
    },
    "notes": {
     "type": "string",
     "minLength": 1
    },
    "data": {
     "type": "object",
     "properties": {},
     "propertyNames": {
      "not": {
       "pattern": "(?i)(ceiling|teto)"
      }
     }
    }
   },
   "required": [
    "schema",
    "contract",
    "contract_version",
    "module",
    "generated_at",
    "metrics"
   ],
   "additionalProperties": false,
   "propertyNames": {
    "not": {
     "pattern": "(?i)(ceiling|teto)"
    }
   }
  },
  "metrics_spec": {
   "type": "object",
   "properties": {
    "schema": {
     "const": "bo.metrics_spec/1"
    },
    "contract": {
     "const": "C15"
    },
    "contract_version": {
     "enum": [
      "3.0.0",
      "3.1.0"
     ]
    },
    "module": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/stable_id"
    },
    "generated_at": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/datetime"
    },
    "metrics": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "metric_id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^M-[A-Za-z0-9_\\-]+$"
       },
       "definition": {
        "type": "string",
        "minLength": 10
       },
       "reading": {
        "enum": [
         "field",
         "decision",
         "graph",
         "complete_unit"
        ]
       },
       "axis": {
        "enum": [
         "representability",
         "transportability",
         "operational",
         "persistence",
         "behavior"
        ]
       },
       "quantifier": {
        "enum": [
         "existential",
         "universal",
         "observed_fraction"
        ]
       },
       "frame": {
        "type": "string",
        "minLength": 5
       },
       "inclusion": {
        "type": "string",
        "minLength": 5
       },
       "weights": {
        "enum": [
         "uniform",
         "frame",
         "inverse_probability",
         "custom"
        ]
       },
       "uncertainty": {
        "enum": [
         "bootstrap",
         "delta",
         "bayesian",
         "exact",
         "wilson",
         "none"
        ]
       }
      },
      "required": [
       "metric_id",
       "definition",
       "reading",
       "axis",
       "quantifier",
       "frame",
       "inclusion",
       "weights",
       "uncertainty"
      ],
      "additionalProperties": false,
      "propertyNames": {
       "not": {
        "pattern": "(?i)(ceiling|teto)"
       }
      }
     },
     "minItems": 1
    }
   },
   "required": [
    "schema",
    "contract",
    "contract_version",
    "module",
    "generated_at",
    "metrics"
   ],
   "additionalProperties": false
  },
  "summary_results": {
   "allOf": [
    {
     "$ref": "https://w3id.org/brevops/contracts/C17/manifest_receipt.schema.json#/$defs/summary"
    },
    {
     "required": [
      "results"
     ]
    }
   ],
   "description": "summary.json (C17) que carrega métricas C15 no bloco results"
  }
 }
}
