{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://w3id.org/brevops/contracts/C12/readback_outcomes.schema.json",
 "title": "C12 readback_outcomes 3.1.0: leitura e desfecho de persistência",
 "description": "Leitura com redação na origem; desfecho como união discriminada {axis: persistence, value: PERSISTED | ALTERED | REJECTED_BY_API | NOT_READABLE | INFRA_ERROR | UNKNOWN}, a mesma do C22 (C00 #/$defs/outcome); case_id e group_id; estado de evidência antes e depois.",
 "x-bo-contract": {
  "id": "C12",
  "name": "readback_outcomes",
  "version": "3.1.0",
  "status": "amended",
  "owner": "CONTRACTS",
  "files": [
   {
    "kind": "readback",
    "file": "readback.jsonl",
    "format": "jsonl",
    "record": "readback",
    "unit": "record"
   },
   {
    "kind": "outcomes",
    "file": "outcomes.jsonl",
    "format": "jsonl",
    "record": "outcome_record",
    "unit": "record"
   }
  ],
  "semantic_rules": [
   "C12-UNION: outcome é a união do C00 com axis = persistence",
   "C12-LADDER: o estado de evidência só sobe com PERSISTED; com os demais desfechos after <= before",
   "C12-READ: desfecho PERSISTED/ALTERED exige readback_id (a leitura que o sustenta)",
   "C12-WITHHELD: campo withheld não tem valor (nem hash)",
   "C12-NODE: (node_id, path) único no registro; sem node_id o caminho é do único recurso do caso (o prefixo '<nó>.' no path continua aceito)"
  ],
  "producers": [
   "DEP-{provider}-A",
   "DEP-{provider}-B",
   "JUDGE",
   "SMOKE-{provider}"
  ],
  "consumers": [],
  "adopted_from": []
 },
 "$defs": {
  "readback": {
   "type": "object",
   "properties": {
    "readback_id": {
     "type": "string",
     "minLength": 1,
     "pattern": "^RB-[A-Za-z0-9_\\-]+$"
    },
    "case_id": {
     "type": "string",
     "minLength": 1,
     "pattern": "^CASE-[A-Za-z0-9_\\-]+$"
    },
    "group_id": {
     "type": "string",
     "minLength": 1,
     "pattern": "^(GRP|G)-[A-Za-z0-9_\\-]+$"
    },
    "claim_id": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/claim_id"
    },
    "side": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/side"
    },
    "provider": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/provider"
    },
    "read_at": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/datetime"
    },
    "protocol_version": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/semver"
    },
    "fields": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "path": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+|\\[[0-9]+\\])*$"
       },
       "node_id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[rc][0-9]+$",
        "description": "nó do graph_ir/plano (C26) dono do campo, quando o caso tem vários recursos (emenda 3.1.0)"
       },
       "state": {
        "enum": [
         "read",
         "absent",
         "not_read",
         "withheld"
        ]
       },
       "value": {},
       "redaction": {
        "type": "object",
        "properties": {
         "rule_id": {
          "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/rule_id"
         },
         "at_source": {
          "const": true
         }
        },
        "required": [
         "rule_id",
         "at_source"
        ],
        "additionalProperties": false
       }
      },
      "required": [
       "path",
       "state"
      ],
      "additionalProperties": false,
      "allOf": [
       {
        "if": {
         "properties": {
          "state": {
           "const": "read"
          }
         }
        },
        "then": {
         "required": [
          "value"
         ]
        }
       },
       {
        "if": {
         "properties": {
          "state": {
           "enum": [
            "absent",
            "not_read",
            "withheld"
           ]
          }
         }
        },
        "then": {
         "not": {
          "required": [
           "value"
          ]
         }
        }
       },
       {
        "if": {
         "properties": {
          "state": {
           "const": "withheld"
          }
         }
        },
        "then": {
         "required": [
          "redaction"
         ]
        }
       }
      ],
      "description": "Withheld nunca tem valor nem hash; a redação acontece na origem"
     },
     "minItems": 1
    }
   },
   "required": [
    "readback_id",
    "case_id",
    "group_id",
    "claim_id",
    "side",
    "provider",
    "read_at",
    "protocol_version",
    "fields"
   ],
   "additionalProperties": false
  },
  "outcome_record": {
   "type": "object",
   "properties": {
    "outcome_id": {
     "type": "string",
     "minLength": 1,
     "pattern": "^OUT-[A-Za-z0-9_\\-]+$"
    },
    "case_id": {
     "type": "string",
     "minLength": 1,
     "pattern": "^CASE-[A-Za-z0-9_\\-]+$"
    },
    "group_id": {
     "type": "string",
     "minLength": 1,
     "pattern": "^(GRP|G)-[A-Za-z0-9_\\-]+$"
    },
    "claim_id": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/claim_id"
    },
    "side": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/side"
    },
    "outcome": {
     "allOf": [
      {
       "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/outcome"
      },
      {
       "properties": {
        "axis": {
         "const": "persistence"
        }
       }
      }
     ]
    },
    "evidence_state_before": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/evidence_state"
    },
    "evidence_state_after": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/evidence_state"
    },
    "readback_id": {
     "type": "string",
     "minLength": 1,
     "pattern": "^RB-[A-Za-z0-9_\\-]+$"
    },
    "rule_id": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/rule_id"
    },
    "decided_at": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/datetime"
    }
   },
   "required": [
    "outcome_id",
    "case_id",
    "group_id",
    "claim_id",
    "side",
    "outcome",
    "evidence_state_before",
    "evidence_state_after",
    "rule_id",
    "decided_at"
   ],
   "additionalProperties": false
  }
 }
}
