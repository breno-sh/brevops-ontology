{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://w3id.org/brevops/contracts/C29/domain_contracts.schema.json",
 "title": "C29 domain_contracts 1.0.0: contratos de domínio e fragmentos",
 "description": "Por domínio: identidade, dono e alcance; extensão de autorização (principal, permissão, efeito, binding, escopo, herança, contexto, combinação); fragmento de rede; grafos de LB e banco; unidades de decisão; observabilidade; OUT_OF_PIN | UNSUPPORTED_BY_TRANSLATOR | UNRESOLVED | ausência demonstrada (ABSENCE_DEMONSTRATED, com evidência).",
 "x-bo-contract": {
  "id": "C29",
  "name": "domain_contracts",
  "version": "1.0.0",
  "status": "new_v3",
  "owner": "CONTRACTS",
  "files": [
   {
    "kind": "domain_contracts",
    "file": "domain_contracts.yaml",
    "format": "yaml",
    "record": "domain_contracts",
    "unit": "document"
   },
   {
    "kind": "fragment",
    "file": "fragments/*.json",
    "format": "json",
    "record": "fragment",
    "unit": "document"
   }
  ],
  "semantic_rules": [
   "C29-FRAG: todo fragmento citado existe em fragments/ irmão e é do mesmo domínio e do tipo certo",
   "C29-EDGES: arestas do fragmento citam nós dele",
   "C29-UNIQ: um contrato por domínio"
  ],
  "producers": [
   "DOMAIN-CONTRACTS"
  ],
  "consumers": [],
  "adopted_from": []
 },
 "$defs": {
  "domain_contract": {
   "type": "object",
   "properties": {
    "domain": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/domain"
    },
    "identity": {
     "type": "object",
     "properties": {
      "key_fields": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1
       },
       "minItems": 1
      },
      "composite": {
       "type": "boolean"
      }
     },
     "required": [
      "key_fields",
      "composite"
     ],
     "additionalProperties": false
    },
    "owner": {
     "type": "object",
     "properties": {
      "rule": {
       "type": "string",
       "minLength": 5
      }
     },
     "required": [
      "rule"
     ],
     "additionalProperties": false
    },
    "scope": {
     "type": "object",
