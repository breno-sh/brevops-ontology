    "network_fragment": {
     "type": "string",
     "minLength": 1,
     "pattern": "^FRG-[A-Za-z0-9_\\-]+$"
    },
    "graphs": {
     "type": "object",
     "properties": {
      "lb": {
       "type": "string",
       "minLength": 1,
       "pattern": "^FRG-[A-Za-z0-9_\\-]+$"
      },
      "db": {
