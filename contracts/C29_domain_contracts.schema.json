       "pattern": "^FRG-[A-Za-z0-9_\\-]+$"
      }
     },
     "additionalProperties": false
    },
    "decision_units": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "name": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_]*$"
       },
       "decision": {
        "type": "string",
        "minLength": 5
       },
       "units": {
        "type": "array",
        "items": {
         "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/unit_id"
        }
       }
      },
      "required": [
       "name",
       "decision"
      ],
      "additionalProperties": false
     },
     "minItems": 1
    },
    "observability": {
     "type": "object",
     "properties": {
