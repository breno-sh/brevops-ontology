   "additionalProperties": false
  },
  "domain_contracts": {
   "type": "object",
   "properties": {
    "schema": {
     "const": "bo.domain_contracts/1"
    },
    "contract": {
     "const": "C29"
    },
    "contract_version": {
     "const": "1.0.0"
    },
    "module": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/stable_id"
    },
    "generated_at": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/datetime"
    },
    "domains": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/domain_contract"
     },
     "minItems": 1
    }
   },
   "required": [
    "schema",
    "contract",
    "contract_version",
    "module",
    "generated_at",
    "domains"
   ],
   "additionalProperties": false
  },
  "fragment": {
   "type": "object",
   "properties": {
    "fragment_id": {
     "type": "string",
     "minLength": 1,
     "pattern": "^FRG-[A-Za-z0-9_\\-]+$"
    },
    "domain": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/domain"
    },
    "kind": {
     "enum": [
      "authorization",
      "network",
      "lb_graph",
      "db_graph"
     ]
    },
    "nodes": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "node_id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^n[0-9]+$"
       },
       "kind": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_]*$"
       },
       "unit_id": {
