       "type": "object",
       "properties": {
        "status": {
         "enum": [
          "SUPPORTED",
          "OUT_OF_PIN",
          "UNSUPPORTED_BY_TRANSLATOR",
          "UNRESOLVED",
          "ABSENCE_DEMONSTRATED"
         ]
        },
        "note": {
         "type": "string",
