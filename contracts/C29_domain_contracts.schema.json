      "principal": {
       "type": "object",
       "properties": {
        "status": {
         "enum": [
          "SUPPORTED",
          "OUT_OF_PIN",
          "UNSUPPORTED_BY_TRANSLATOR",
          "UNRESOLVED",
          "ABSENCE_DEMONSTRATED"
         ]
        },
        "note": {
         "type": "string",
         "minLength": 3
        },
        "evidence": {
         "type": "array",
         "items": {
          "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/evidence_item"
         }
        }
       },
       "required": [
        "status"
       ],
       "additionalProperties": false,
       "allOf": [
        {
         "if": {
          "properties": {
           "status": {
            "const": "ABSENCE_DEMONSTRATED"
           }
          }
         },
         "then": {
          "required": [
           "evidence"
          ],
          "properties": {
           "evidence": {
            "minItems": 1
           }
          }
         }
        }
       ]
      },
      "permission": {
       "type": "object",
