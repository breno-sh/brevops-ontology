{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://w3id.org/brevops/contracts/C25/service_evidence.schema.json",
 "title": "C25 service_evidence 1.3.0: evidência de API e docs ligada ao pin",
 "description": "Fato de API/docs ligado ao pin: recurso de API, identidade, chave de importação, controlador de ciclo de vida, dono, alcance, estado de conexão, efeito, precedência, suporte a tag/TTL; nível (publicado | derivado | interpretado) e citação. Citação publicada separada de inferência; desconhecido explícito.",
 "x-bo-contract": {
  "id": "C25",
  "name": "service_evidence",
  "version": "1.3.0",
  "status": "amended",
  "owner": "CONTRACTS",
  "files": [
   {
    "kind": "service_evidence",
    "file": "service_evidence.jsonl",
    "format": "jsonl",
    "record": "service_evidence",
    "unit": "record"
   },
   {
    "kind": "protocol_support",
    "file": "protocol_support.jsonl",
    "format": "jsonl",
    "record": "protocol_support",
    "unit": "record",
    "note": "suporte documentado de cada tipo de sonda por provedor (emenda 1.2.0; consumido pelo PROBEKIT)"
   }
  ],
  "semantic_rules": [
   "C25-LEVEL: publicado cita a sentença (citation, doc ou schema do binário assinado); derivado aponta de quais fatos; interpretado tem model_id",
   "C25-UNKNOWN: unknown cita a publicação consultada (consulted, citation, doc ou schema); level é opcional",
   "C25-DEFAULT: default afirmado tem as_of (como o C03-DEFAULT); api_bridge liga api_resource ao tipo",
   "C25-API: api_resource.resource aceita o marcador UNKNOWN quando a página não nomeia o recurso",
   "C25-BLOCK: block_path, quando há, é caminho de bloco do tipo e terraform_resource_type está presente",
   "C25-DERIVED: derived_from cita evidence_id do mesmo arquivo",
   "C25-PS-UNIQ: (probe_type, provider, terraform_resource_type) único em protocol_support.jsonl",
   "C25-PS-PUB: documented_* tem ao menos uma evidência published; validated é sempre false",
   "C25-UNIQ: evidence_id único"
  ],
  "producers": [
   "SERVICE-EVIDENCE"
  ],
  "consumers": [],
  "adopted_from": []
 },
 "$defs": {
  "service_evidence": {
   "type": "object",
   "properties": {
    "evidence_id": {
     "type": "string",
     "minLength": 1,
     "pattern": "^SE-[A-Za-z0-9_\\-]+$"
    },
    "provider": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/provider"
    },
    "pin": {
     "type": "object",
     "properties": {
      "provider_version": {
       "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/semver"
      },
      "api_version": {
       "type": "string",
       "minLength": 1
      }
     },
     "required": [
      "provider_version"
     ],
     "additionalProperties": false
    },
    "api_resource": {
     "type": "object",
     "properties": {
      "service": {
       "type": "string",
       "minLength": 1
      },
      "resource": {
       "type": "string",
       "minLength": 1
      }
     },
     "required": [
      "service",
      "resource"
     ],
     "additionalProperties": false
    },
    "terraform_resource_type": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/resource_type"
    },
    "block_path": {
     "type": "string",
     "minLength": 1,
     "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$",
     "description": "bloco do tipo a que o fato se refere (emenda 1.1.0)"
    },
    "as_of": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/date"
    },
    "schema": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/schema_source"
    },
    "rule_id": {
     "type": "string",
     "minLength": 1,
     "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$",
     "description": "regra do SERVICE-EVIDENCE que gerou o fato (emenda 1.3.0)"
    },
    "consulted": {
     "anyOf": [
      {
       "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/doc_source"
      },
      {
       "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/web_citation"
      },
      {
       "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/schema_source"
      }
     ],
     "description": "publicação consultada para um fato unknown (a busca pode ser refeita)"
    },
    "fact_kind": {
     "enum": [
      "identity",
      "import_key",
      "lifecycle_controller",
      "owner",
      "effective_scope",
      "connection_state",
      "effect",
      "precedence",
      "tag_support",
      "ttl_support",
      "api_bridge",
      "default"
     ]
    },
    "status": {
     "enum": [
      "stated",
      "unknown"
     ]
    },
    "value": {},
    "unknown_reason": {
     "enum": [
      "not_documented",
      "ambiguous",
      "contradictory",
      "out_of_pin"
     ]
    },
    "level": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/evidence_level"
    },
    "model_id": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/model_id"
    },
    "citation": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/web_citation"
    },
    "doc": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/doc_source"
    },
    "derived_from": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1,
      "pattern": "^SE-[A-Za-z0-9_\\-]+$"
     },
     "minItems": 1
    }
   },
   "required": [
    "evidence_id",
    "provider",
    "pin",
    "api_resource",
    "fact_kind",
    "status"
   ],
   "additionalProperties": false,
   "allOf": [
    {
     "if": {
      "properties": {
       "status": {
        "const": "stated"
       }
      }
     },
     "then": {
      "required": [
       "value",
       "level"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "status": {
        "const": "unknown"
       }
      }
     },
     "then": {
      "required": [
       "unknown_reason"
      ],
      "not": {
       "required": [
        "value"
       ]
      },
      "anyOf": [
       {
        "required": [
         "consulted"
        ]
       },
       {
        "required": [
         "citation"
        ]
       },
       {
        "required": [
         "doc"
        ]
       },
       {
        "required": [
         "schema"
        ]
       }
      ]
     }
    },
    {
     "if": {
      "properties": {
       "fact_kind": {
        "const": "default"
       },
       "status": {
        "const": "stated"
       }
      }
     },
     "then": {
      "required": [
       "as_of"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "level": {
        "const": "published"
       },
       "status": {
        "const": "stated"
       }
      },
      "required": [
       "level"
      ]
     },
     "then": {
      "anyOf": [
       {
        "required": [
         "citation"
        ],
        "properties": {
         "citation": {
          "required": [
           "sentence"
          ]
         }
        }
       },
       {
        "required": [
         "doc"
        ]
       },
       {
        "required": [
         "schema"
        ]
       }
      ]
     }
    },
    {
     "if": {
      "properties": {
       "level": {
        "const": "derived"
       }
      },
      "required": [
       "level"
      ]
     },
     "then": {
      "required": [
       "derived_from"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "level": {
        "const": "interpreted"
       }
      },
      "required": [
       "level"
      ]
     },
     "then": {
      "required": [
       "model_id"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "level": {
        "enum": [
         "published",
         "derived"
        ]
       }
      },
      "required": [
       "level"
      ]
     },
     "then": {
      "not": {
       "required": [
        "model_id"
       ]
      }
     }
    }
   ]
  },
  "protocol_support": {
   "type": "object",
   "properties": {
    "schema": {
     "const": "bo.protocol_support/1"
    },
    "probe_type": {
     "enum": [
      "item_ttl",
      "log_retention",
      "object_lifecycle",
      "object_versioning",
      "queue_retention",
      "rate_limit"
     ]
    },
    "provider": {
     "enum": [
      "aws",
      "google",
      "azurerm",
      "oci"
     ]
    },
    "pin": {
     "type": "object",
     "properties": {
      "provider_version": {
       "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/semver"
      }
     },
     "required": [
      "provider_version"
     ],
     "additionalProperties": false
    },
    "terraform_resource_type": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/resource_type"
    },
    "attributes": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$"
     }
    },
    "status": {
     "enum": [
      "documented_supported",
      "documented_unsupported",
      "unknown"
     ]
    },
    "requirement": {
     "type": "object",
     "properties": {
      "text": {
       "type": "string",
       "minLength": 3
      },
      "max_seconds": {
       "anyOf": [
        {
         "type": "null"
        },
        {
         "type": "integer",
         "minimum": 0
        }
       ]
      }
     },
     "required": [
      "text",
      "max_seconds"
     ],
     "additionalProperties": false
    },
    "documented": {
     "type": "object"
    },
    "reason": {
     "type": "string",
     "minLength": 3
    },
    "evidence": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "level": {
        "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/evidence_level"
       },
       "ref": {
        "type": "string",
        "minLength": 1
       },
       "doc": {
        "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/doc_source"
       },
       "citation": {
        "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/web_citation"
       },
       "schema": {
        "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/schema_source"
       },
       "model_id": {
        "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/model_id"
       },
       "note": {
        "type": "string",
        "minLength": 3
       }
      },
      "required": [
       "level"
      ],
      "additionalProperties": false,
      "allOf": [
       {
        "if": {
         "properties": {
          "level": {
           "const": "interpreted"
          }
         }
        },
        "then": {
         "required": [
          "model_id",
          "note"
         ]
        }
       },
       {
        "if": {
         "properties": {
          "level": {
           "const": "published"
          }
         }
        },
        "then": {
         "anyOf": [
          {
           "required": [
            "doc"
           ]
          },
          {
           "required": [
            "citation"
           ]
          },
          {
           "required": [
            "schema"
           ]
          }
         ],
         "not": {
          "required": [
           "model_id"
          ]
         }
        }
       },
       {
        "if": {
         "properties": {
          "level": {
           "const": "derived"
          }
         }
        },
        "then": {
         "anyOf": [
          {
           "required": [
            "ref"
           ]
          },
          {
           "required": [
            "doc"
           ]
          },
          {
           "required": [
            "note"
           ]
          }
         ],
         "not": {
          "required": [
           "model_id"
          ]
         }
        }
       }
      ]
     },
     "minItems": 1
    },
    "validated": {
     "const": false,
     "description": "suporte só documentado; validar é do PROBEKIT"
    }
   },
   "required": [
    "schema",
    "probe_type",
    "provider",
    "pin",
    "terraform_resource_type",
    "attributes",
    "status",
    "requirement",
    "documented",
    "evidence",
    "validated"
   ],
   "additionalProperties": false,
   "allOf": [
    {
     "if": {
      "properties": {
       "status": {
        "const": "unknown"
       }
      }
     },
     "then": {
      "required": [
       "reason"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "status": {
        "const": "documented_supported"
       }
      }
     },
     "then": {
      "properties": {
       "attributes": {
        "minItems": 1
       }
      }
     }
    }
   ]
  }
 }
}
