{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://w3id.org/brevops/contracts/C20/glossary.schema.json",
 "title": "C20 glossary 3.3.0: glossário, âncoras como alegações, auditoria e decisões",
 "description": "Conceito com grandeza (IRI | NOT_APPLICABLE | UNKNOWN); âncora como alegação com sentença, contexto, contraexemplo procurado, método de extração e evidence_state (STRUCTURALLY_VALID | DOC_SUPPORTED | PERSISTENCE_VERIFIED | OBSERVATION_TESTED | UNRESOLVED).",
 "x-bo-contract": {
  "id": "C20",
  "name": "glossary",
  "version": "3.3.0",
  "status": "amended",
  "owner": "CONTRACTS",
  "files": [
   {
    "kind": "glossary",
    "file": "glossary.jsonl",
    "format": "jsonl",
    "record": "concept",
    "unit": "record"
   },
   {
    "kind": "claims",
    "file": "claims.jsonl",
    "format": "jsonl",
    "record": "anchor_claim",
    "unit": "record"
   },
   {
    "kind": "glossary_audit",
    "file": "glossary_audit.jsonl",
    "format": "jsonl",
    "record": "audit",
    "unit": "record"
   },
   {
    "kind": "decisions",
    "file": "decisions.jsonl",
    "format": "jsonl",
    "record": "decision",
    "unit": "record",
    "note": "decisões do glossarista: hierarquia (broader/narrower), tipo de valor, distinções…"
   }
  ],
  "semantic_rules": [
   "C20-IDS: claim_version_id = <claim_id>@n, únicos; event_id único por versão; supersedes = versão anterior da mesma alegação (claim_id nunca muda entre versões)",
   "C20-NA: grandeza NOT_APPLICABLE não tem unidade; UNKNOWN ≠ NOT_APPLICABLE",
   "C20-AUDIT: a auditoria cita uma versão existente quando claims.jsonl é irmão",
   "C20-UNIQ: concept_id único; decision_id único",
   "C20-DEC-DIR: broader = concept_id ⊂ related_concept (direção de skos:broader); narrower = o inverso",
   "C20-DEC-REF: concept_id e related_concept existem no glossary.jsonl irmão (quando há); nunca o mesmo",
   "C20-DEC-ACYCLIC: a hierarquia (broader e narrower invertido) não tem ciclo",
   "C20-ANCHOR: anchor_kind atom (ou ausente) ancora em atom_id; block em block_id e type em type_id, sempre com implication (que valor do conceito o bloco/tipo implica); as alternativas citadas são de outro bloco/tipo, com valores distintos",
   "C20-UNRESOLVED: âncora UNRESOLVED pode vir sem sentença; o motivo vai no context (nunca sentença inventada); as demais exigem sentence (emenda 3.3.0, CC-6 do PILOT-STO-GLOSS)",
   "C20-EVREF: evidence_ref cita o fato C03 do átomo ou C25 do tipo de onde veio a sentença"
  ],
  "producers": [
   "GLOSSARY-AUDIT",
   "GLOSSARY-FREEZE",
   "GLOSSARY-{domain}",
   "PILOT-{slice}-GLOSS"
  ],
  "consumers": [],
  "adopted_from": []
 },
 "$defs": {
  "concept": {
   "type": "object",
   "properties": {
    "concept_id": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/concept_id"
    },
    "label": {
     "type": "string",
     "minLength": 2
    },
    "definition": {
     "type": "string",
     "minLength": 10
    },
    "domain": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/domain"
    },
    "quantity_kind": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/quantity_kind"
    },
    "unit": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/unit_qudt"
    },
    "status": {
     "enum": [
      "active",
      "deprecated",
      "merged",
      "split"
     ]
    },
    "replaced_by": {
     "type": "array",
     "items": {
      "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/concept_id"
     },
     "minItems": 1
    },
    "evidence_state": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/evidence_state"
    }
   },
   "required": [
    "concept_id",
    "label",
    "definition",
    "domain",
    "quantity_kind",
    "status",
    "evidence_state"
   ],
   "additionalProperties": false,
   "allOf": [
    {
     "if": {
      "properties": {
       "status": {
        "enum": [
         "merged",
         "split",
         "deprecated"
        ]
       }
      }
     },
     "then": {
      "required": [
       "replaced_by"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "quantity_kind": {
        "const": "NOT_APPLICABLE"
       }
      }
     },
     "then": {
      "properties": {
       "unit": {
        "const": "NOT_APPLICABLE"
       }
      }
     }
    }
   ]
  },
  "anchor_claim": {
   "type": "object",
   "properties": {
    "claim_id": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/claim_id"
    },
    "claim_version_id": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/claim_version_id"
    },
    "event_id": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/event_id"
    },
    "supersedes": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/claim_version_id"
    },
    "concept_id": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/concept_id"
    },
    "atom_id": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/atom_id"
    },
    "anchor_kind": {
     "enum": [
      "atom",
      "block",
      "type"
     ],
     "description": "onde a âncora mora: átomo (padrão quando ausente), bloco ou tipo (emenda 3.2.0)"
    },
    "block_id": {
     "type": "string",
     "minLength": 1,
     "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*:[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$",
     "description": "provider:resource_type:caminho.do.bloco"
    },
    "type_id": {
     "type": "string",
     "minLength": 1,
     "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
    },
    "implication": {
     "type": "object",
     "properties": {
      "realization": {
       "enum": [
        "block_choice",
        "type_choice"
       ]
      },
      "value": {},
      "rule": {
       "type": "string",
       "minLength": 10
      },
      "alternatives": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "ref": {
          "type": "string",
          "minLength": 3
         },
         "value": {}
        },
        "required": [
         "ref",
         "value"
        ],
        "additionalProperties": false
       }
      }
     },
     "required": [
      "realization",
      "value",
      "rule"
     ],
     "additionalProperties": false,
     "description": "que valor do conceito o bloco/tipo implica (ex.: deny{} -> effect = deny)"
    },
    "sentence": {
     "type": "string",
     "minLength": 10
    },
    "context": {
     "type": "string",
     "minLength": 5
    },
    "evidence_ref": {
     "type": "object",
     "properties": {
      "contract": {
       "enum": [
        "C03",
        "C25"
       ]
      },
      "id": {
       "type": "string",
       "minLength": 1,
       "pattern": "^(DF|SE)-[A-Za-z0-9][A-Za-z0-9_.:\\-]*$"
      }
     },
     "required": [
      "contract",
      "id"
     ],
     "additionalProperties": false,
     "description": "fato do C03 (do átomo) ou do C25 (do tipo) que dá a sentença (emenda 3.3.0, CC-NET-4)"
    },
    "counterexample_search": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "minLength": 3
      },
      "found": {
       "type": "boolean"
      },
      "result": {
       "type": "string",
       "minLength": 3
      }
     },
     "required": [
      "query",
      "found",
      "result"
     ],
     "additionalProperties": false
    },
    "extraction_method": {
     "enum": [
      "parser",
      "regex",
      "table",
      "manual",
      "model"
     ]
    },
    "evidence_level": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/evidence_level"
    },
    "model_id": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/model_id"
    },
    "source": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/doc_source"
    },
    "evidence_state": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/evidence_state"
    },
    "recorded_at": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/datetime"
    }
   },
   "required": [
    "claim_id",
    "claim_version_id",
    "event_id",
    "concept_id",
    "context",
    "counterexample_search",
    "extraction_method",
    "evidence_level",
    "evidence_state",
    "recorded_at"
   ],
   "additionalProperties": false,
   "allOf": [
    {
     "if": {
      "properties": {
       "evidence_state": {
        "const": "UNRESOLVED"
       }
      }
     },
     "then": {
      "properties": {
       "context": {
        "type": "string",
        "minLength": 15
       }
      }
     },
     "else": {
      "required": [
       "sentence"
      ]
     }
    },
    {
     "if": {
      "anyOf": [
       {
        "not": {
         "required": [
          "anchor_kind"
         ]
        }
       },
       {
        "properties": {
         "anchor_kind": {
          "const": "atom"
         }
        }
       }
      ]
     },
     "then": {
      "required": [
       "atom_id"
      ],
      "not": {
       "anyOf": [
        {
         "required": [
          "block_id"
         ]
        },
        {
         "required": [
          "type_id"
         ]
        },
        {
         "required": [
          "implication"
         ]
        }
       ]
      }
     }
    },
    {
     "if": {
      "properties": {
       "anchor_kind": {
        "const": "block"
       }
      },
      "required": [
       "anchor_kind"
      ]
     },
     "then": {
      "required": [
       "block_id",
       "implication"
      ],
      "properties": {
       "implication": {
        "properties": {
         "realization": {
          "const": "block_choice"
         }
        }
       }
      },
      "not": {
       "anyOf": [
        {
         "required": [
          "atom_id"
         ]
        },
        {
         "required": [
          "type_id"
         ]
        }
       ]
      }
     }
    },
    {
     "if": {
      "properties": {
       "anchor_kind": {
        "const": "type"
       }
      },
      "required": [
       "anchor_kind"
      ]
     },
     "then": {
      "required": [
       "type_id",
       "implication"
      ],
      "properties": {
       "implication": {
        "properties": {
         "realization": {
          "const": "type_choice"
         }
        }
       }
      },
      "not": {
       "anyOf": [
        {
         "required": [
          "atom_id"
         ]
        },
        {
         "required": [
          "block_id"
         ]
        }
       ]
      }
     }
    },
    {
     "if": {
      "properties": {
       "evidence_level": {
        "const": "interpreted"
       }
      }
     },
     "then": {
      "required": [
       "model_id"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "extraction_method": {
        "const": "model"
       }
      }
     },
     "then": {
      "properties": {
       "evidence_level": {
        "const": "interpreted"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "evidence_state": {
        "enum": [
         "DOC_SUPPORTED"
        ]
       }
      }
     },
     "then": {
      "required": [
       "source"
      ]
     }
    }
   ],
   "description": "âncora como alegação: claim_id imutável; cada versão tem claim_version_id e event_id próprios"
  },
  "audit": {
   "type": "object",
   "properties": {
    "audit_id": {
     "type": "string",
     "minLength": 1,
     "pattern": "^GA-[A-Za-z0-9_\\-]+$"
    },
    "claim_id": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/claim_id"
    },
    "claim_version_id": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/claim_version_id"
    },
    "event_id": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/event_id"
    },
    "check": {
     "enum": [
      "evidence_support",
      "same_quantity_distinction",
      "indirect_anchor",
      "no_test_in_train",
      "counterexample"
     ]
    },
    "result": {
     "enum": [
      "pass",
      "fail",
      "unresolved"
     ]
    },
    "evidence_state_before": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/evidence_state"
    },
    "evidence_state_after": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/evidence_state"
    },
    "auditor": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/stable_id"
    },
    "at": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/datetime"
    },
    "note": {
     "type": "string",
     "minLength": 3
    }
   },
   "required": [
    "audit_id",
    "claim_id",
    "claim_version_id",
    "event_id",
    "check",
    "result",
    "evidence_state_before",
    "evidence_state_after",
    "auditor",
    "at"
   ],
   "additionalProperties": false
  },
  "decision": {
   "type": "object",
   "properties": {
    "schema": {
     "const": "bo.glossary_decision/1"
    },
    "decision_id": {
     "type": "string",
     "minLength": 1,
     "pattern": "^GD-[A-Za-z0-9_\\-]+$"
    },
    "kind": {
     "enum": [
      "broader",
      "narrower",
      "value_type",
      "same_kind_distinct",
      "merge",
      "split",
      "exclusive",
      "ungrounded"
     ]
    },
    "concept_id": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/concept_id"
    },
    "related_concept": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/concept_id"
    },
    "value": {
     "type": "object",
     "properties": {
      "datatype": {
       "enum": [
        "integer",
        "decimal",
        "boolean",
        "string",
        "enum",
        "duration",
        "tuple"
       ]
      },
      "enum_semantics": {
       "type": "string",
       "minLength": 3
      },
      "rate_window": {
       "anyOf": [
        {
         "type": "null"
        },
        {
         "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/xsd_duration"
        }
       ]
      },
      "byte_convention": {
       "enum": [
        "SI",
        "IEC",
        "NOT_APPLICABLE"
       ]
      }
     },
     "required": [
      "datatype"
     ],
     "additionalProperties": false
    },
    "reason": {
     "type": "string",
     "minLength": 10
    },
    "evidence": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "source": {
        "type": "string",
        "minLength": 3
       },
       "sentence": {
        "type": "string",
        "minLength": 3
       },
       "date": {
        "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/date"
       }
      },
      "required": [
       "source",
       "sentence",
       "date"
      ],
      "additionalProperties": false
     }
    },
    "author": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/stable_id"
    },
    "recorded_at": {
     "$ref": "https://w3id.org/brevops/contracts/C00/conventions.schema.json#/$defs/datetime"
    }
   },
   "required": [
    "schema",
    "decision_id",
    "kind",
    "concept_id",
    "reason",
    "evidence",
    "author",
    "recorded_at"
   ],
   "additionalProperties": false,
   "allOf": [
    {
     "if": {
      "properties": {
       "kind": {
        "enum": [
         "broader",
         "narrower",
         "same_kind_distinct",
         "merge",
         "split"
        ]
       }
      }
     },
     "then": {
      "required": [
       "related_concept"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "kind": {
        "const": "value_type"
       }
      }
     },
     "then": {
      "required": [
       "value"
      ]
     },
     "else": {
      "not": {
       "required": [
        "value"
       ]
      }
     }
    }
   ],
   "description": "decisão do glossarista; broader: concept_id é o mais estreito (concept_id skos:broader related_concept); narrower: o inverso (emenda 3.1.0, formato provisório do GLOSSARY_BRIEF)"
  }
 }
}
