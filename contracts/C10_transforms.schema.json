{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://w3id.org/brevops/contracts/C10/transforms.schema.json",
 "title": "C10 transforms 3.0.0: transformações, gramática de guarda e tabela de composição",
 "description": "Transformação escalar (grandeza de entrada = de saída) separada de combinador de tupla; domínio e codomínio, pré-condições, erro, perda, inversa parcial; durações com mês/ano só com contexto; gramática de guarda tipada e decidível (eq, in, present, refers_to_kind, region_in, edition_in, version_range) com teste de satisfatibilidade; tabela de composição.",
 "x-bo-contract": {
  "id": "C10",
  "name": "transforms",
  "version": "3.0.0",
  "status": "changed_v3",
  "owner": "CONTRACTS",
  "files": [
   {
    "kind": "transforms",
    "file": "transforms.yaml",
    "format": "yaml",
    "record": "transforms",
    "unit": "document"
   },
   {
    "kind": "conditions_grammar",
    "file": "conditions.grammar.json",
    "format": "json",
    "record": "conditions_grammar",
    "unit": "document"
   },
   {
    "kind": "composition_table",
    "file": "composition_table.json",
    "format": "json",
    "record": "composition_table",
    "unit": "document"
   },
   {
    "kind": "guard",
    "file": "guard.json",
    "format": "json",
    "record": "guard",
    "unit": "document",
    "note": "uma guarda solta (stub e testes)"
   }
  ],
  "semantic_rules": [
   "C10-KIND: transformação escalar tem a mesma grandeza na entrada e na saída (kind_in = kind_out só vale para escalar); tupla vai em combinators",
   "C10-CAL: duração com mês/ano (P…M, P…Y) só com context_required ∋ calendar",
   "C10-INV: inverse.name, quando há, é transformação declarada no mesmo documento",
   "C10-SAT: cada sat_test dá o resultado esperado em bo.semantics.guards.satisfiable",
   "C10-TABLE: semantic_relation e value_domain_relation cobrem os 25 pares (r1, r2) uma vez cada; transport_fidelity os 16 pares (f1, f2)",
   "C10-GUARD: guarda passa no typecheck da gramática"
  ],
  "producers": [
   "SEMANTICS",
   "TRANSFORMS"
  ],
  "consumers": [],
  "adopted_from": [
   "results/SEMANTICS/C10_proposta/guard.schema.json",
   "results/SEMANTICS/C10_proposta/composition_table.schema.json",
   "results/SEMANTICS/C10_proposta/conditions.grammar.json"
  ]
 },
