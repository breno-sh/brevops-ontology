# Linha de exemplo para ~/.ssh/authorized_keys da VM: a chave do runner só executa o supervisor (forced command),
# sem shell, sem encaminhamento. Trocar <CHAVE_PUBLICA_DO_RUNNER> pela chave pública dedicada (nunca a pessoal).
command="/usr/bin/python3 -I -B ~/bo-supervisor/pkg/bo_supervisor.py ssh-entry",no-port-forwarding,no-agent-forwarding,no-X11-forwarding,no-pty,restrict <CHAVE_PUBLICA_DO_RUNNER> bo-runner
